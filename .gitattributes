# 统一换行符为 LF，避免 Windows 检出时文件被改成 CRLF
# （Dockerfile 的 RUN 续行、shell 脚本一旦带 CR 会在容器内报错）
* text=auto eol=lf

# 明确声明为 LF 的文本文件
*.py   text eol=lf
*.sh   text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
*.txt  text eol=lf
*.j2   text eol=lf
*.html text eol=lf
*.example text eol=lf
Dockerfile text eol=lf
VERSION text eol=lf

# 二进制文件（不做换行转换）
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
*.gz   binary
*.zip  binary
*.tar  binary
*.xlsx binary
*.db   binary
